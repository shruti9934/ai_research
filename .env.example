# Copy this file to .env and fill in ONE provider's key.

# --- Option 1: Google Gemini (has a free tier: https://aistudio.google.com/apikey)
LLM_PROVIDER=gemini
GOOGLE_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- Option 2: OpenAI
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Tuning (optional)
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=150
# TOP_K=5
# MAX_REFLECTION_RETRIES=1

# Optional: make the Streamlit UI call a running FastAPI server instead of running the agent itself.
# Set it in your shell, e.g.  API_URL=http://localhost:8000 streamlit run ui.py
# API_URL=http://localhost:8000
